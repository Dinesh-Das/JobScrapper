# Database Configuration (unchanged ? pool size sufficient for low concurrency)
db.url=jdbc:oracle:thin:@127.0.0.1:1521:XE
db.user=system
db.password=root
db.pool.size=20
db.connection.timeout=60000
db.leak.detection.threshold=300000
db.sub.batch.size=25

# Scraper Configuration - SLOW, STEALTH MODE
scraper.threads=5
scraper.total.pages=8000
scraper.page.offset=1
scraper.page.load.delay=2000
scraper.batch.size=200
scraper.job.search.url=https://www.naukri.com/software-developer-jobs-in-india-{page}
scraper.max.retries=5
scraper.retry.delay=5000
scraper.check.duplicates=true
scraper.upsert.duplicates=false
scraper.rate.limit.delay=4000
scraper.circuit.breaker.threshold=5
# Stop Phase 1 after this many consecutive empty search pages
scraper.empty.page.limit=8
# Recycle the Chrome session every N pages/URLs per worker
scraper.driver.restart.every=80
# true = reuse urls_checkpoint.txt and skip collecting more pages
scraper.skip.phase1=false
# Warning-only by default; the scraper does not abort on robots.txt
scraper.check.robots.txt=true
scraper.respect.robots.txt=true

# Browser Configuration - SLOW, STEALTH MODE
browser.headless=true
browser.disable.images=true
browser.wait.timeout=30
# Hard cap so driver.get() cannot hang forever
browser.page.load.timeout=25
browser.tab.switch.timeout=5
browser.click.delay=200